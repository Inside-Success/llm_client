          "revision": "287d0cb2af229db4c03923ad4047d7dfe79310dd"
        },
        {
          "kind": "ArchitectureDecision",
          "id": "ADR-0016",
          "revision": "2026-07-23-amended"
        }
      ],
      "outputs": [
        "Public OpenRouterRoutePolicyV1 API",
        "Deterministic provider-payload compiler",
        "Replayable route-policy snapshot",
        "Non-retryable compatible-route failure",
        "Passing deterministic test evidence",
        "Non-private live route observation"
      ],
      "dependencies": [],
      "conflict_surfaces": [
        {
          "kind": "repository_path",
          "target": "llm_client/",
          "repository": "llm_client",
          "access": "exclusive",
          "coordination_key": "llm-client-plan-336-runtime"
        },
        {
          "kind": "repository_path",
          "target": "tests/",
          "repository": "llm_client",
          "access": "exclusive",
          "coordination_key": "llm-client-plan-336-tests"
        },
        {
          "kind": "repository_path",
          "target": "docs/adr/0016-provider-capability-and-vendor-telemetry-boundary.md",
          "repository": "llm_client",
          "access": "exclusive",
          "coordination_key": "llm-client-adr-0016"
        }
      ],
      "acceptance": [
        {
          "id": "AC-336-01-contract",
          "criterion": "The typed policy validates and compiles exactly as Plan 336 specifies.",
          "evidence_required": [
            "Passing positive and malformed policy tests",
            "Exact compiled provider object assertion"
          ],
          "negative_control": "Raw provider kwargs plus typed policy fail before provider dispatch."
        },
        {
          "id": "AC-336-01-replay",
          "criterion": "The canonical route policy participates in snapshot, cache identity, and replay.",
          "evidence_required": [
            "Original and replay provider objects match",
            "Policy mutation changes request identity",
            "Old snapshot compatibility test"
          ],
          "negative_control": "A malformed replay policy fails before dispatch."
        },
        {
          "id": "AC-336-01-failure",
          "criterion": "No-compatible-route is distinct from model absence and receives no internal retry.",
          "evidence_required": [
            "Typed error classification test",
            "One-attempt lifecycle test",
            "Ordinary model-not-found control"
          ],
          "negative_control": "A generic OpenRouter 404 without the compatible-route signature remains model-not-found."
        },
        {
          "id": "AC-336-01-live",
          "criterion": "A bounded non-private strict-schema call returns validated output through an allowed upstream and retains actual upstream evidence.",
          "evidence_required": [
            "Fresh trace ID",
            "Validated Pydantic result",
            "Authenticated OpenRouter generation evidence",
            "Exact accepted Git revision"
          ],
          "negative_control": "The live fixture contains no private or customer content and uses num_retries=0."
        }
      ],
      "readiness": {
        "status": "ready",
        "required_approval_types": [],
        "approvals": [],
        "failed_guards": []
      },
      "status": "accepted",
      "record_version": 1
    },
