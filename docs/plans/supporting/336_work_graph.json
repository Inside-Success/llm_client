      "profile": "standard",
      "execution_class": "independently_executable",
      "claimability": "not_applicable",
      "authorization_mode": "host_workspace",
      "scope": {
        "included": [
          "Typed OpenRouterRoutePolicyV1 contract and public exports",
          "Completions and Responses compilers for sync, async, structured, tool, and streaming calls",
          "Snapshot/replay identity",
          "LLMNoCompatibleRouteError classification and no-retry behavior",
          "Focused and full deterministic verification",
          "One bounded non-private OpenRouter route probe"
        ],
        "excluded": [
          "Private Slack data",
          "Live endpoint registry or preflight cache",
          "Model selection or Auto Router",
          "Embeddings",
          "Caller repository migration",
          "Package publication or deployment"
        ]
      },
      "inputs": [
        {
          "kind": "ImplementationPlan",
          "id": "plan-336",
          "revision": "plan-336-v1"
        },
        {
          "kind": "GitRevision",
