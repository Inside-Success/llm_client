#!/bin/bash
# Pre-commit hook (portable meta-process template)
# Each check only runs if its script is installed.
# Install via: meta-process/install.sh

set -e

echo "Running pre-commit checks..."

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

COMMON_GIT_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
CANONICAL_REPO_ROOT=$(dirname "$COMMON_GIT_DIR")
PYTHON_BIN=""
for CANDIDATE in \
    "$REPO_ROOT/.venv/bin/python" \
    "$CANONICAL_REPO_ROOT/.venv/bin/python" \
    "$REPO_ROOT/.venv/Scripts/python.exe" \
    "$CANONICAL_REPO_ROOT/.venv/Scripts/python.exe"; do
    if [[ -x "$CANDIDATE" ]]; then
        PYTHON_BIN="$CANDIDATE"
        break
    fi
done
if [[ -z "$PYTHON_BIN" ]]; then
    echo "ERROR: no repository virtualenv Python found in the worktree or canonical checkout."
    echo "Create .venv in one of those locations before committing."
    exit 1
fi
echo "Using Python: $PYTHON_BIN"

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" == "main" && "${ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
    echo ""
    echo "ERROR: direct commits on 'main' are blocked."
    echo ""
    echo "Use worktree/branch + PR workflow:"
    echo "  make worktree BRANCH=plan-NN-description TASK=\"<task>\""
    echo "  cd worktrees/plan-NN-description"
    echo "  git commit ..."
    echo ""
    echo "Emergency override (use sparingly):"
    echo "  ALLOW_MAIN_COMMIT=1 git commit ..."
    echo ""
    exit 1
fi

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

# Helper: find a script at either scripts/meta/ or scripts/
find_script() {
    local name="$1"
    if [[ -f "$REPO_ROOT/scripts/meta/$name" ]]; then
        echo "$REPO_ROOT/scripts/meta/$name"
    elif [[ -f "$REPO_ROOT/scripts/$name" ]]; then
        echo "$REPO_ROOT/scripts/$name"
    fi
}

# 1. Plan index regeneration (if generator exists)
GENERATOR=$(find_script "generate_plan_index.py")
if [[ -n "$GENERATOR" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Regenerating plan index..."
        "$PYTHON_BIN" "$GENERATOR"
        git add docs/plans/CLAUDE.md
    fi
fi

# 2. Validate doc coupling before any generator mutates the worktree.
DOC_COUPLING=$(find_script "check_doc_coupling.py")
if [[ -n "$DOC_COUPLING" ]]; then
    echo "Checking doc-code coupling..."
    ACK_ARGS=()
    if [[ -f "$REPO_ROOT/.doc-coupling-acks" ]]; then
        ACK_ARGS=(--ack-file "$REPO_ROOT/.doc-coupling-acks")
    fi
    if ! "$PYTHON_BIN" "$DOC_COUPLING" --staged --strict "${ACK_ARGS[@]}"; then
        echo ""
        echo "ERROR: Locked doc-coupling violation detected!"
        echo "Run 'python $DOC_COUPLING --suggest' to see which docs to update."
        echo "Do not touch unrelated docs solely to satisfy co-modification."
        echo ""
        exit 1
    fi
fi

# 3. Generated API reference sync after validation succeeds.
API_REFERENCE_GEN=$(find_script "generate_api_reference.py")
if [[ -n "$API_REFERENCE_GEN" ]]; then
    STAGED_API=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(llm_client/.*\.py|docs/API_REFERENCE\.(md|html)|scripts/meta/generate_api_reference\.py|scripts/doc_coupling\.yaml)$' || true)
    if [[ -n "$STAGED_API" ]]; then
        echo "Regenerating API reference docs..."
        "$PYTHON_BIN" "$API_REFERENCE_GEN" --write
        git add docs/API_REFERENCE.md docs/API_REFERENCE.html
    fi
fi

# 4. Mypy on changed src/ files (if mypy is installed)
STAGED_SRC=$(echo "$STAGED_PY" | grep '^src/' || true)
if [[ -n "$STAGED_SRC" ]] && command -v mypy >/dev/null 2>&1; then
    echo "Running mypy on changed files..."
    if ! "$PYTHON_BIN" -m mypy --strict --ignore-missing-imports --follow-imports=silent $STAGED_SRC; then
        echo ""
        echo "ERROR: mypy type check failed!"
        echo ""
        exit 1
    fi
fi

# 5. Plan status consistency (if script exists and plan files staged)
SYNC_STATUS=$(find_script "sync_plan_status.py")
if [[ -n "$SYNC_STATUS" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Checking plan status consistency..."
        if ! "$PYTHON_BIN" "$SYNC_STATUS" --check; then
            echo ""
            echo "ERROR: Plan status inconsistency detected!"
            echo "Run 'python $SYNC_STATUS --check' to see details"
            echo ""
            exit 1
        fi
    fi
fi

# 6. Branch divergence check
echo "Checking branch freshness..."
if ! git fetch origin; then
    echo "ERROR: unable to fetch origin; branch freshness cannot be verified."
    exit 1
fi

REMOTE="origin/$BRANCH"

if git rev-parse --verify "$REMOTE" >/dev/null 2>&1; then
    LOCAL_ONLY=$(git rev-list "$REMOTE..HEAD" --count)
    REMOTE_ONLY=$(git rev-list "HEAD..$REMOTE" --count)

    if [ "$REMOTE_ONLY" -gt 0 ] && [ "$LOCAL_ONLY" -gt 0 ]; then
        echo ""
        echo "ERROR: Branch has diverged from remote!"
        echo "  Local commits not on remote: $LOCAL_ONLY"
        echo "  Remote commits not local: $REMOTE_ONLY"
        echo ""
        # `git pull --rebase` refuses outright when the index has staged changes, which
        # is always true here: this is a pre-commit hook, so the caller is mid-commit
        # with a populated index. Printing the bare rebase left the caller deadlocked --
        # the hook demanding a rebase, the rebase demanding a clean index -- and the
        # only escape on offer, --no-verify, lands the unrebased commit this check
        # exists to prevent. Prescribe the sequence that can actually run.
        if git diff --cached --quiet; then
            echo "Resolution:"
            echo "  git pull --rebase origin $BRANCH"
        else
            echo "Resolution (your index has staged changes, so rebase must be"
            echo "unblocked first -- a bare 'git pull --rebase' will refuse):"
            echo "  git stash push -m pre-commit-rebase"
            echo "  git pull --rebase origin $BRANCH"
            echo "  git stash pop --index    # --index preserves what you had staged"
            echo "  # then re-run your commit"
        fi
        echo ""
        echo "Bypass with: git commit --no-verify"
        echo "  This does NOT resolve the divergence -- it commits on top of a stale"
        echo "  base and pushes the conflict downstream. Prefer the resolution above."
        exit 1
    fi

    if [ "$REMOTE_ONLY" -gt 5 ]; then
        echo "WARNING: Branch is $REMOTE_ONLY commits behind remote"
        echo "Consider: git pull --rebase origin $BRANCH"
    fi
fi

# Reachability ratchet: the orphaned-module count may fall, never rise.
# A module nobody imports is work that was finished and never wired to
# anything. Catching it at commit is the only point where the author still
# knows whether it was meant to be wired or meant to be deleted.
echo "Checking module reachability..."
if [ -f scripts/meta/check_reachability.py ]; then
    if ! python3 scripts/meta/check_reachability.py --project-root . --check; then
        echo ""
        echo "Bypass with: REACHABILITY_RATCHET=off git commit ..."
        [ "${REACHABILITY_RATCHET:-on}" = "off" ] || exit 1
        echo "REACHABILITY_RATCHET=off - regression recorded but not blocked."
    fi
fi

echo "Pre-commit checks passed!"
